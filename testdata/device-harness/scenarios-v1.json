      "schema_version": "synora.oem-test-scenario/v1",
      "classification": "component",
      "boundary": "internal/discovery/runtime.Registry",
      "logical_clock": "2026-10-11T12:00:00Z",
      "seed": 11,
      "devices": [{"id":"camera-h3-1","kind":"camera","capabilities":["vision"],"available":true,"connected":true,"state":{"stream":"ready"}}],
      "steps": [
        {"id":"offline","action":"operate","device_id":"camera-h3-1","operation":"observe","capability":"vision","fault":"device_unavailable"},
        {"id":"recover","action":"recover","device_id":"camera-h3-1","fault":"device_recovery"},
        {"id":"probe","action":"operate","device_id":"camera-h3-1","operation":"observe","capability":"vision","state_after":{"stream":"ready"}},
        {"id":"timeout","action":"operate","device_id":"camera-h3-1","operation":"observe","capability":"vision","fault":"timeout"},
        {"id":"delay","action":"operate","device_id":"camera-h3-1","operation":"observe","capability":"vision","fault":"delayed_response","delay_ms":250}
      ],
      "expected":{"trace":["offline:unavailable","recover:recovered","probe:simulated","timeout:timeout","delay:delayed"],"observation_ids":[],"device_state":{"stream":"ready"},"device_available":true,"device_connected":true,"physical_action_executed":false,"cleanup_complete":true,"final_clock":"2026-10-11T12:00:00.25Z"}
